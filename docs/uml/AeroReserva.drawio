 impide superposición)" style="endArrow=open;html=1;fontSize=11;strokeColor=#496f60;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1022" y="640" /><mxPoint as="targetPoint" x="652" y="640" /></mxGeometry></mxCell><mxCell id="m10" value="reserva confirmada" style="endArrow=open;html=1;fontSize=11;strokeColor=#496f60;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="652" y="680" /><mxPoint as="targetPoint" x="402" y="680" /></mxGeometry></mxCell><mxCell id="m11" value="[conflicto / error] ROLLBACK" style="endArrow=open;html=1;fontSize=11;strokeColor=#496f60;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1022" y="735" /><mxPoint as="targetPoint" x="652" y="735" /></mxGeometry></mxCell><mxCell id="m12" value="mensaje comprensible, sin cambios parciales" style="endArrow=open;html=1;fontSize=11;strokeColor=#496f60;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="652" y="775" /><mxPoint as="targetPoint" x="402" y="775" /></mxGeometry></mxCell><mxCell id="m13" value="8. actualizar vista / mostrar resultado" style="endArrow=open;html=1;fontSize=11;strokeColor=#496f60;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="402" y="840" /><mxPoint as="targetPoint" x="152" y="840" /></mxGeometry></mxCell><mxCell id="note" value="Adaptación del diseño: un bloqueo asesor común serializa las escrituras del prototipo; la exclusión GiST por recurso es una segunda defensa. La reprogramación desactiva ocupaciones anteriores dentro de la misma transacción." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#52756c;fillColor=#f4f8f6;shape=note;fillColor=#fff9e9;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="875" width="1050" height="55" /></mxCell></root></mxGraphModel></diagram></mxfile>