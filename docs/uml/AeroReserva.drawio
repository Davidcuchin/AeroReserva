riores dentro de la misma transacción." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#52756c;fillColor=#f4f8f6;shape=note;fillColor=#fff9e9;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="875" width="1050" height="55" /></mxCell></root></mxGraphModel></diagram></mxfile>